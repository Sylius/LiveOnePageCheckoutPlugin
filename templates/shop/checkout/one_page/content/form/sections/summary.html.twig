{% import '@SyliusShop/shared/macro/money.html.twig' as money %}
{% import '@SyliusAdmin/shared/helper/button.html.twig' as button %}
{% import '@SyliusShop/shared/macro/loader.html.twig' as loader %}

{% set order = hookable_metadata.context.resource %}
{% set form = hookable_metadata.context.form %}

<div class="card border-0 shadow mb-3 position-sticky" style="top: 1.5rem; max-height: calc(100vh - 3rem); overflow-y: auto;">
    {{ loader.render() }}
    <div class="card-body p-4">
        {% for item in order.items %}
            <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                <div class="flex-shrink-0" style="width: 3.5rem;">
                    <div class="overflow-hidden bg-light rounded-3" style="aspect-ratio: 1/1;">
                        {{ component('sylius_shop:main_image', {
                            product: item.variant.hasImages ? item.variant : item.variant.product,
                            class: 'w-100 h-100 object-fit-cover',
                            filter: 'sylius_shop_product_small_thumbnail',
                        }) }}
                    </div>
                </div>
                <div class="flex-grow-1">
                    <div class="text-break" {{ sylius_test_html_attribute('checkout-summary-item-name', item.productName) }}>{{ item.productName }}</div>
                    <small class="text-body-tertiary" {{ sylius_test_html_attribute('checkout-summary-item-quantity') }}>
                        {{ item.quantity }} x {{ money.convertAndFormat(item.unitPrice) }}
                    </small>
                </div>
            </div>
        {% endfor %}

        <h3 class="mt-4 mb-3 fw-bold">{{ 'sylius.ui.summary'|trans }}</h3>

        <div class="d-flex align-items-center mb-2">
            <div class="d-flex align-items-center gap-2">
                {{ ux_icon('tabler:shopping-bag', { class: 'icon icon-sm text-body-tertiary' }) }}
                {{ 'sylius.ui.items_total'|trans }}
            </div>
            <div class="ms-auto">{{ money.convertAndFormat(order.itemsSubtotal) }}</div>
        </div>

        {% if order.shipments is not empty %}
            <div class="d-flex align-items-center mb-2">
                <div class="d-flex align-items-center gap-2">
                    {{ ux_icon('tabler:truck', { class: 'icon icon-sm text-body-tertiary' }) }}
                    {{ 'sylius.ui.shipping_estimated_cost'|trans }}
                </div>
                <div class="ms-auto">{{ money.convertAndFormat(order.shippingTotal) }}</div>
            </div>
        {% endif %}

        {% if order.orderPromotionTotal %}
            <div class="d-flex align-items-center mb-2 text-success">
                <div class="d-flex align-items-center gap-2">
                    {{ ux_icon('tabler:discount', { class: 'icon icon-sm' }) }}
                    {{ 'sylius.ui.discount'|trans }}
                </div>
                <div class="ms-auto">{{ money.convertAndFormat(order.orderPromotionTotal) }}</div>
            </div>
        {% endif %}

        {% set tax_included = order.getTaxIncludedTotal() %}
        {% set tax_excluded = order.getTaxExcludedTotal() %}
        <div class="d-flex align-items-center mb-2">
            <div class="d-flex align-items-center gap-2">
                {{ ux_icon('tabler:receipt-tax', { class: 'icon icon-sm text-body-tertiary' }) }}
                <div>
                    {{ 'sylius.ui.taxes_total'|trans }}
                    {% if tax_included %}
                        <small class="text-body-tertiary">({{ 'sylius.ui.included_in_price'|trans }})</small>
                    {% endif %}
                </div>
            </div>
            <div class="ms-auto">{{ money.convertAndFormat(tax_excluded ?: tax_included) }}</div>
        </div>

        <div class="mb-2">
            <label class="fw-bold d-flex align-items-center gap-2 mb-2">
                {{ ux_icon('tabler:ticket', { class: 'icon icon-sm text-primary' }) }}
                {{ 'sylius.ui.apply_coupon'|trans }}
            </label>
            {% if form.promotionCoupon.vars.value is not empty and form.promotionCoupon.vars.valid %}
                <div class="d-none">
                    {{ form_widget(form.promotionCoupon) }}
                </div>
                <div class="d-flex flex-row justify-content-between align-items-center w-100 py-2 px-3 border rounded-3 bg-light">
                    <span class="badge d-flex align-items-center gap-1 text-bg-success">
                        {{ ux_icon('tabler:discount-check', { class: 'icon icon-xs' }) }}
                        {{ form.promotionCoupon.vars.value }}
                    </span>
                    <button type="button" class="btn btn-sm btn-transparent d-flex align-items-center p-0 text-danger"
                            data-action="live#action:prevent"
                            data-live-action-param="removeCoupon"
                            {{ sylius_test_html_attribute('cart-promotion-remove-coupon') }}
                    >
                        {{ ux_icon('tabler:trash', {class: 'icon icon-sm'}) }}
                    </button>
                </div>
            {% else %}
                <div class="input-group field">
                    {{ form_widget(form.promotionCoupon, sylius_test_form_attribute('cart-promotion-coupon-input')|sylius_merge_recursive({'attr': {'data-model': 'norender|sylius_live_one_page_checkout_checkout[promotionCoupon]', 'form': form.vars.id, 'placeholder': 'sylius.ui.enter_your_code'|trans ~ '...'}})) }}
                    <button class="btn btn-primary px-3" type="button" data-action="live#$render">{{ ux_icon('tabler:arrow-right', { class: 'icon icon-sm' }) }}</button>
                </div>
                {{ form_errors(form.promotionCoupon) }}
            {% endif %}
        </div>

        <div class="d-flex align-items-center pt-3 mt-3 mb-4 border-top">
            <div class="d-flex align-items-center gap-2 fw-bold">
                {{ ux_icon('tabler:cash', { class: 'icon icon-sm text-primary' }) }}
                {{ 'sylius.ui.order_total'|trans }}
            </div>
            <div class="ms-auto fw-bold h4">{{ money.convertAndFormat(order.total) }}</div>
        </div>

        {{ button.primary({ text: 'sylius.ui.pay'|trans, type: 'submit', form: form.vars.id, class: 'w-100' }) }}
    </div>
</div>
