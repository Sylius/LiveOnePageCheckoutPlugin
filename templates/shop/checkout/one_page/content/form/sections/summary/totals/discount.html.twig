{% import '@SyliusShop/shared/macro/money.html.twig' as money %}

{% set order_promotion_adjustment = constant('Sylius\\Component\\Core\\Model\\AdjustmentInterface::ORDER_PROMOTION_ADJUSTMENT') %}
{% set item_promotion_adjustment = constant('Sylius\\Component\\Core\\Model\\AdjustmentInterface::ORDER_ITEM_PROMOTION_ADJUSTMENT') %}
{% set order = hookable_metadata.context.resource %}
{% set discount = order.getAdjustmentsTotalRecursively(order_promotion_adjustment) + order.getAdjustmentsTotalRecursively(item_promotion_adjustment) %}

{% if discount %}
    <div class="d-flex align-items-center mb-2 text-success" {{ sylius_test_html_attribute('promotion-discount') }}>
        <div class="d-flex align-items-center gap-2">
            {{ ux_icon('tabler:discount', { class: 'icon icon-sm' }) }}
            {{ 'sylius.ui.discount'|trans }}
        </div>
        <div class="ms-auto">{{ money.convertAndFormat(discount) }}</div>
    </div>
{% endif %}
