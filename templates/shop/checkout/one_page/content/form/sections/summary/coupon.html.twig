{% set form = hookable_metadata.context.form %}

<div class="mb-2">
    <label class="fw-bold d-flex align-items-center gap-2 mb-2">
        {{ ux_icon('tabler:ticket', { class: 'icon icon-sm text-primary' }) }}
        {{ 'sylius.ui.apply_coupon'|trans }}
    </label>
    {% if form.promotionCoupon.vars.value is not empty and form.promotionCoupon.vars.valid %}
        <div class="d-none">
            {{ form_widget(form.promotionCoupon) }}
        </div>
        <div class="d-flex flex-row justify-content-between align-items-center w-100 py-2 px-3 border rounded-3 bg-light">
            <span class="badge d-flex align-items-center gap-1 text-bg-success" {{ sylius_test_html_attribute('applied-coupon') }}>
                {{ ux_icon('tabler:discount-check', { class: 'icon icon-xs' }) }}
                {{ form.promotionCoupon.vars.value }}
            </span>
            <button type="button" class="btn btn-sm btn-transparent d-flex align-items-center p-0 text-danger"
                    data-action="live#action:prevent"
                    data-live-action-param="removeCoupon"
                    {{ sylius_test_html_attribute('remove-coupon') }}
            >
                {{ ux_icon('tabler:trash', {class: 'icon icon-sm'}) }}
            </button>
        </div>
    {% else %}
        <div class="input-group field" {{ sylius_test_html_attribute('coupon') }}>
            {{ form_widget(form.promotionCoupon, {'attr': {'data-model': 'norender|sylius_live_one_page_checkout_checkout[promotionCoupon]', 'form': form.vars.id, 'placeholder': 'sylius.ui.enter_your_code'|trans ~ '...'}}) }}
            <button class="btn btn-primary px-3" type="button" data-action="live#$render" {{ sylius_test_html_attribute('apply-coupon') }}>{{ ux_icon('tabler:arrow-right', { class: 'icon icon-sm' }) }}</button>
        </div>
        {{ form_errors(form.promotionCoupon) }}
    {% endif %}
</div>
