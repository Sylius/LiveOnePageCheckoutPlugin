{% set form = hookable_metadata.context.form %}
{% set show_billing = form.differentBillingAddress is not defined or form.differentBillingAddress.vars.data %}
{% set prefixes = hookable_metadata.prefixes|merge(['sylius_live_one_page_checkout.shop.shared.form']) %}

{% if show_billing and form.defaultBillingAddress is defined %}
    <div class="mb-4">
        {% hook 'address_book' with {
            _prefixes: prefixes,
            default_addresses: form.defaultBillingAddress,
            new_address: form.newBillingAddress,
            toggle_action: 'toggleNewBillingAddress',
        } %}
    </div>
{% endif %}
