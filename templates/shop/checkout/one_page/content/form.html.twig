{% form_theme form '@SyliusShop/form/theme.html.twig' %}

<div class="mt-4" {{ attributes }}>
    {{ form_start(form, { attr: { id: form.vars.id, novalidate: 'novalidate' } }) }}
    <input type="hidden" name="_method" value="PUT"/>
    {{ form_errors(form) }}
    {{ form_widget(form._token) }}
    {{ form_widget(form.stateHash, { value: stateHash }) }}

    {% hook 'form' with { form, resource } %}

    {{ form_end(form, {render_rest: hookable_metadata.configuration.render_rest|default(false)}) }}
</div>